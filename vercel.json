{
	"cleanUrls": true,
	"rewrites": [
		{ "source": "/es", "destination": "/index.html" },
		{ "source": "/en", "destination": "/index.html" },
		{ "source": "/en/meeting-confirmed", "destination": "/en/meeting-confirmed/index.html" },
		{ "source": "/en/meeting-confirmed/", "destination": "/en/meeting-confirmed/index.html" },
		{ "source": "/es/meeting-confirmed", "destination": "/es/meeting-confirmed/index.html" },
		{ "source": "/es/meeting-confirmed/", "destination": "/es/meeting-confirmed/index.html" },
		{ "source": "/en/book-meeting", "destination": "/en/book-meeting/index.html" },
		{ "source": "/en/book-meeting/", "destination": "/en/book-meeting/index.html" },
		{ "source": "/es/book-meeting", "destination": "/es/book-meeting/index.html" },
		{ "source": "/es/book-meeting/", "destination": "/es/book-meeting/index.html" }
	],
	"headers": [
		{
			"source": "/en/meeting-confirmed",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
		},
		{
			"source": "/en/meeting-confirmed/",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
		},
		{
			"source": "/es/meeting-confirmed",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
		},
		{
			"source": "/es/meeting-confirmed/",
			"headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
		}
	],
	"redirects": [
		{ "source": "/a", "destination": "/", "permanent": false },
		{ "source": "/b", "destination": "/?variant=b", "permanent": false },
		{
			"source": "/:path*",
			"has": [{ "type": "host", "value": "(?<host>(www\\.)?humanauthn\\.(org|io)|(www\\.)?humanauthntech\\.com|www\\.humanauthn\\.com)" }],
			"destination": "https://humanauthn.com/:path*",
			"permanent": true
		}
	]
}
